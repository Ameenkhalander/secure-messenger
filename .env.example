# Copy to .env (never commit .env). Generate a key with:
#   python -c "import secrets; print(secrets.token_hex(32))"
APP_ENV=development
SECRET_KEY=change-me
# Leave empty for SQLite in instance/messenger.db. PostgreSQL example:
# DATABASE_URL=postgresql://messenger:password@localhost:5432/messenger
DATABASE_URL=
COOKIE_SECURE=false
HSTS_ENABLED=false
PUBLIC_BASE_URL=http://localhost:5000
# Behind a reverse proxy set to the number of proxies (e.g. 1) so client IPs are correct
TRUSTED_PROXY_COUNT=0
# Rate limit storage: memory:// (single process) or redis://host:6379
RATELIMIT_STORAGE_URI=memory://
# Optional SMTP for password reset mail (otherwise links are written to instance/outbox.log)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=no-reply@example.com
